                  "$ref": "#/components/schemas/InternalError"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Meta"
      }
    },
    "/api/v1/metrics": {
      "get": {
        "operationId": "metrics_api_v1_metrics_get",
        "parameters": [
          {
            "description": "ISO-8601 with offset, whole hour. Default: window start",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO-8601 with offset, whole hour. Default: window start",
              "title": "From"
            }
          },
          {
            "description": "Exclusive end, ISO-8601 with offset. Default: window end",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive end, ISO-8601 with offset. Default: window end",
              "title": "To"
            }
          },
          {
            "description": "HH:MM, Europe/London on D\u22121. Default: 09:50",
            "in": "query",
            "name": "cutoff",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "HH:MM, Europe/London on D\u22121. Default: 09:50",
              "title": "Cutoff"
            }
          },
          {
            "description": "Default: 0",
            "in": "query",
            "name": "lag_minutes",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 180,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: 0",
              "title": "Lag Minutes"
            }
          },
          {
            "description": "Default: point",
            "in": "query",
            "name": "aggregation",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "point",
                    "hourly_mean"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: point",
              "title": "Aggregation"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Metrics"
      }
    },
    "/api/v1/metrics/by-horizon": {
      "get": {
        "operationId": "metrics_by_horizon_api_v1_metrics_by_horizon_get",
        "parameters": [
          {
            "in": "query",
            "name": "bucket_hours",
            "required": false,
            "schema": {
              "default": 6,
              "maximum": 24,
              "minimum": 1,
              "title": "Bucket Hours",
              "type": "integer"
            }
          },
          {
            "description": "ISO-8601 with offset, whole hour. Default: window start",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO-8601 with offset, whole hour. Default: window start",
              "title": "From"
            }
          },
          {
            "description": "Exclusive end, ISO-8601 with offset. Default: window end",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive end, ISO-8601 with offset. Default: window end",
              "title": "To"
            }
          },
          {
            "description": "HH:MM, Europe/London on D\u22121. Default: 09:50",
            "in": "query",
            "name": "cutoff",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "HH:MM, Europe/London on D\u22121. Default: 09:50",
              "title": "Cutoff"
            }
          },
          {
            "description": "Default: 0",
            "in": "query",
            "name": "lag_minutes",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 180,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: 0",
              "title": "Lag Minutes"
            }
          },
          {
            "description": "Default: point",
            "in": "query",
            "name": "aggregation",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "point",
                    "hourly_mean"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: point",
              "title": "Aggregation"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ByHorizonResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
